# Copy to .env for local runs. On Streamlit Cloud use Secrets instead.
# Never commit real values. This repo is public.

# --- Supabase (SAME project as wnt-nofade-bot and wnt-gap-bot; this bot only writes nolive_* tables) ---
# Use the pooler URL. If :6543 gives ECONNREFUSED, switch the port to :5432 on the same host.
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# false = only send messages. Keep false if you reuse the gap bot's Telegram bot
# (two apps must not both listen on one bot token).
TELEGRAM_COMMANDS=false

# --- the paper rule (v2 defaults; you only need to set a line to change it) ---
SERIES=KXWORLDNEWSMENTION
FIRE_AT_CT=17:32:30
LIMIT_YES_CENTS=30
QUALIFY_MAX_YES_CENTS=30
EXCLUDE_COUNTING_WORDS=true
PAPER_DOLLARS=3
MAX_CONTRACTS_PER_WORD=50
CANCEL_TIMES_CT=17:35,17:40,17:45,17:50,17:55

# =====================================================================
# LIVE (real money). Leave LIVE_DRY_RUN=true (or unset) and nothing real happens.
# Never put a real Kalshi key in this .example file or paste one on a command line --
# use a real .env (gitignored) or Streamlit Secrets, and generate it from a script that
# prompts for it instead.
# =====================================================================
LIVE_DRY_RUN=true
LIVE_SMOKE=false
LIVE_SMOKE_CONTRACTS=1
LIVE_DOLLARS_PER_WORD=5
LIVE_CANCEL_CT=17:55
LIVE_MAX_MARKETS_PER_DAY=25
LIVE_MAX_DAILY_COLLATERAL=150
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
