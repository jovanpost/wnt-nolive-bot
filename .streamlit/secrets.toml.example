# Copy to Streamlit Cloud -> App settings -> Secrets.
# Public repo: never commit the real file.
# PAPER ONLY: no Kalshi key is needed or used.

DATABASE_URL = "postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

TELEGRAM_TOKEN = "123456:ABC..."
TELEGRAM_CHAT_ID = "your-numeric-chat-id"
# false = only send messages (safe if you reuse the gap bot's Telegram bot)
TELEGRAM_COMMANDS = false

# The rules (defaults shown; you only need lines you want to change)
SERIES = "KXWORLDNEWSMENTION"
FIRE_AT_CT = "17:32:30"
LIMIT_YES_CENTS = "55"
SKIP_YES_AT_OR_ABOVE = "98"
PAPER_DOLLARS = "5"
CANCEL_TIMES_CT = "17:35,17:40,17:45,17:50,17:55"
