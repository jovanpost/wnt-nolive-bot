# Copy to Streamlit Cloud -> App settings -> Secrets.
# Public repo: never commit the real file.

DATABASE_URL = "postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

TELEGRAM_TOKEN = "123456:ABC..."
TELEGRAM_CHAT_ID = "your-numeric-chat-id"
# false = only send messages (safe if you reuse the gap bot's Telegram bot)
TELEGRAM_COMMANDS = false

# --- where the workers run ---
# RUN_WORKERS = "false"   # this place is a dashboard only (the workers run on the server)
# KLSH_HOST = "streamlit" # this place's name in the worker lease (the server uses "vps")

# --- the paper rule (v2 defaults shown; you only need lines you want to change) ---
SERIES = "KXWORLDNEWSMENTION"
FIRE_AT_CT = "17:32:30"
LIMIT_YES_CENTS = "30"
QUALIFY_MAX_YES_CENTS = "30"
EXCLUDE_COUNTING_WORDS = true
PAPER_DOLLARS = "3"
MAX_CONTRACTS_PER_WORD = "50"
CANCEL_TIMES_CT = "17:35,17:40,17:45,17:50,17:55"

# =====================================================================
# LIVE (real money). Leave everything below unset, or LIVE_DRY_RUN = true, and nothing real
# happens -- the live engine only simulates. Do not put a real Kalshi key in this .example file;
# paste it directly into Streamlit Cloud's Secrets editor instead.
# =====================================================================
# LIVE_DRY_RUN = true            # true (default) = no real orders, ever. Set to false only when ready.
# LIVE_SMOKE = false             # true = also send one tiny (1-contract) REAL order, for testing
# LIVE_SMOKE_CONTRACTS = "1"
# LIVE_DOLLARS_PER_WORD = "5"    # <- change the real $ amount here
# LIVE_CANCEL_CT = "17:55"
# LIVE_MAX_MARKETS_PER_DAY = "25"
# LIVE_MAX_DAILY_COLLATERAL = "150"
# KALSHI_KEY_ID = "..."
# KALSHI_PRIVATE_KEY_PEM = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
